{
  "name": "dsh-knowledge-base-local",
  "version": "1.2.3",
  "type": "module",
  "description": "A local, model-readable knowledge-base plugin for DeepSeek Harness (DSH): Markdown-first storage, six agent tools, a CLI, a Web settings panel, PDF/Office text extraction, an MCP server for external clients, at-rest AES-256-GCM encryption and role-based multi-user access.",
  "author": "dsh-knowledge-base-local contributors",
  "license": "MIT",
  "homepage": "https://github.com/CodfishYao/dsh-knowledge-base-local#readme",
  "bugs": {
    "url": "https://github.com/CodfishYao/dsh-knowledge-base-local/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodfishYao/dsh-knowledge-base-local.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "knowledge-base",
    "retrieval",
    "rag",
    "markdown",
    "mcp",
    "pdf",
    "office",
    "encryption",
    "agent-tool"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./kb": "./kb.mjs",
    "./mcp": "./src/mcp.js",
    "./mcp/http": "./src/mcp_http.js",
    "./mcp/stdio": "./mcp-stdio.mjs",
    "./extract": "./src/extract_binary.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-kb": "kb.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "kb.mjs",
    "mcp-stdio.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "SECURITY.md",
    "SECURITY.zh.md",
    "locale/",
    "src/",
    "test/"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/extract.test.mjs && node test/integration.test.mjs && node test/panel_api.test.mjs && node test/danger_ops.test.mjs && node test/host_mcp_mount.test.mjs && node test/mcp.test.mjs",
    "lint:css": "node tools/audit-css.mjs client.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  }
}
